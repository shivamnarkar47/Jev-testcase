    {"id": "s3", "action": "Add test 101 rapid POSTs expect 429", "tool": "edit", "args": "tests/ratelimit.test.js", "deps": ["s2"]},
    {"id": "s4", "action": "Run tests and lint", "tool": "shell:npm", "args": "npm test; npm run lint", "deps": ["s3"]}
